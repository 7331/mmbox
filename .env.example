# Required (docker-compose.yml sets it for the app container).
REDIS_URL=redis://redis:6379/0
# Reverse proxies whose client-IP header is trusted: exact addresses only. Empty: every caller is its TCP peer.
# PROXY_TRUSTED_CIDRS=["172.18.0.5/32"]
# PROXY_CLIENT_IP_HEADER=cf-connecting-ip
# Optional, defaults shown.
# MEDIA_MAX_SIZE_BYTES=26214400
# MEDIA_MAX_DIMENSION_PIXELS=4096
# MEDIA_IMAGE_PROCESSING_TIMEOUT_SECONDS=15
# MEDIA_IMAGE_PROCESSING_WORKERS=2
# RATE_LIMITS_UPLOADS_PER_HOUR=30
# RATE_LIMITS_FETCHES_PER_MINUTE=120
# S3_API_TIMEOUT_SECONDS=30
# S3_API_MAX_LISTING_BYTES=2097152
